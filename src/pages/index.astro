---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getPublicAsset } from '../lib/publicAsset';
import { TOPICS } from '../lib/topics';

const posts = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const recent = posts.slice(0, 3);
const formatDate = (date: string) => new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(new Date(`${date}T12:00:00`));
---

<SiteLayout title="Smart Sail Boat Deck" description="A public journal of selected vessel stories, systems work, refits, voyages, and lessons from Smart Sail Boat.">
  <section class="home-hero">
    <div class="shell hero-copy">
      <p class="eyebrow">Smart Sail Boat / Deck</p>
      <h1 class="display">A working log from the water.</h1>
      <p class="lead">Selected stories about the vessels, systems, refits, voyages, and lessons behind Smart Sail Boat.</p>
      <div class="hero-meta meta"><span>Built around real work</span><span>Published with evidence and care</span></div>
    </div>
  </section>

  <section class="shell section" aria-labelledby="latest-title">
    <div class="section-head"><div><p class="eyebrow">Latest from the deck</p><h2 id="latest-title">Stories in progress.</h2></div>{posts.length > 3 && <a class="text-link" href="/stories/">View all stories →</a>}</div>
    {recent.length > 0 ? <div class="story-grid">{recent.map((post) => { const image = getPublicAsset(post.data.image); return <a class="story-card" href={`/stories/${post.data.slug}/`}><div class="story-image" style={image ? `background-image:url("${image}")` : undefined}></div><div class="story-copy"><div class="badge-row"><span class="badge">{post.data.topic.label}</span>{post.data.vessel && <span class="badge badge--outline">{post.data.vessel}</span>}</div><h3>{post.data.title}</h3>{post.data.excerpt && <p>{post.data.excerpt}</p>}<div class="card-foot"><span>{formatDate(post.data.date)}</span><span>Read ↗</span></div></div></a>; })}</div> : <div class="empty-state"><h2>The first story is being prepared.</h2><p>Deck publishes only selected, reviewed material. Approved project and vessel stories will appear here when they are ready.</p></div>}
  </section>

  <section class="shell section" aria-labelledby="topics-title">
    <div class="section-head"><div><p class="eyebrow">Explore the work</p><h2 id="topics-title">From systems to sea trials.</h2></div></div>
    <div class="topic-grid">{TOPICS.map((topic) => <a class="topic-card" href={`/stories/?topic=${topic.slug}`}><strong>{topic.label}</strong><span>{topic.description}</span></a>)}</div>
  </section>
</SiteLayout>
